# Copy to hosts.yml (gitignored) and fill in the values.
# Ansible reaches every node over Tailscale, so it runs the same from your Mac or a CI runner.
all:
  children:
    k3s_cluster:
      children:
        k3s_server:
          hosts:
            vps-master:
              ansible_host: vps-master          # Tailscale MagicDNS name, or the VPS public IP
              ansible_user: root
              k3s_node_external_ip: "<VPS_PUBLIC_IP>"
        k3s_agents:
          hosts:
            laptop-wsl:
              ansible_host: laptop-wsl          # Tailscale MagicDNS name of the WSL instance
              ansible_user: "<WSL_USER>"
              k3s_node_labels:
                - location=home
                - hardware=laptop
              # Nothing lands on the laptop unless it tolerates this taint.
              k3s_node_taints:
                - location=home:NoSchedule
