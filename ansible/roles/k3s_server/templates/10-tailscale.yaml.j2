# Managed by Ansible (roles/k3s_server). Merged by k3s with config.yaml.
node-ip: {{ tailscale_ip }}
node-external-ip: {{ k3s_node_external_ip }}
flannel-iface: {{ k3s_flannel_iface }}
tls-san:
{% for san in [k3s_node_external_ip, tailscale_ip, tailscale_hostname | default(inventory_hostname)] + k3s_extra_tls_sans %}
  - {{ san }}
{% endfor %}
